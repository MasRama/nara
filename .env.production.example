# Production Environment Template
# Copy this to .env.production on your server (DO NOT commit .env.production)

# Server
NODE_ENV=production
PORT=5555
APP_URL=https://yourdomain.com

# Behind a reverse proxy (Caddy, nginx) on the same host, the proxy holds the
# TLS certificate and the application speaks plain HTTP to it. Listen on
# loopback only, so the port cannot be reached around the proxy, and trust the
# address the proxy forwards: without it every visitor shares one rate limit
# and one sign-in lockout. See docs/deployment.md.
# HOST=127.0.0.1
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1

# Database
DB_FILE=database/production.sqlite3

# Scheduled database backups: one every 24 hours, the newest 7 kept, written
# beside the database. Set the hours to 0 to turn them off. A backup on the
# same disk does not survive losing that disk: point DB_BACKUP_DIR at other
# storage, or copy the directory off the host.
# DB_BACKUP_INTERVAL_HOURS=24
# DB_BACKUP_KEEP=7
# DB_BACKUP_DIR=database/backups

# Activity Feature: retention (days). Set 0 only when the application intentionally
# keeps an unbounded audit history and storage growth is managed separately.
# ACTIVITY_RETENTION_DAYS=365

# Initial admin bootstrap (`npm run setup`)
# Set these before first setup to avoid using the development convenience
# credential. An explicitly configured password is treated as intentional.
# NARA_ADMIN_NAME=Admin
# NARA_ADMIN_EMAIL=admin@example.com
# NARA_ADMIN_PASSWORD=replace-with-a-strong-password

# Logging
LOG_LEVEL=info
# LOG_PRETTY=true

# Security (defaults are production-safe; uncomment to override)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# MAX_JSON_BODY_BYTES=1048576

# Auth Feature: sign-in lockout per email or IP (uncomment to override)
# AUTH_LOCKOUT_ATTEMPTS=5
# AUTH_LOCKOUT_WINDOW_MS=900000
