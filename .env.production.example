# Production Environment Template
# Copy this to .env.production on your server (DO NOT commit .env.production)

# Server
NODE_ENV=production
PORT=5555
APP_URL=https://yourdomain.com

# Database
DB_FILE=database/production.sqlite3

# Initial admin bootstrap (`npm run setup`)
# Set these before first setup to avoid using the development convenience
# credential. An explicitly configured password is treated as intentional.
# NARA_ADMIN_NAME=Admin
# NARA_ADMIN_EMAIL=admin@example.com
# NARA_ADMIN_PASSWORD=replace-with-a-strong-password

# Logging
LOG_LEVEL=info
# LOG_PRETTY=true

# Security (defaults are production-safe; uncomment to override)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_LOCKOUT_ATTEMPTS=5
# AUTH_LOCKOUT_WINDOW_MS=900000
# MAX_JSON_BODY_BYTES=1048576
# TRUST_PROXY=false
# TRUST_PROXY_HOPS=1
