#!/bin/sh
# Nara pre-commit hook — runs layer boundary lint + AGENTS.md accuracy.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

echo "── Nara pre-commit check ──"

npx ts-node scripts/lint-layers.ts
if [ $? -ne 0 ]; then
  echo "❌ Layer boundary lint failed. Fix violations above."
  exit 1
fi

npx ts-node scripts/check-agents.ts
if [ $? -ne 0 ]; then
  echo "❌ AGENTS.md accuracy check failed. Update the Structure table(s) above."
  exit 1
fi

npx ts-node scripts/codemap.ts >/dev/null 2>&1
if ! git diff --exit-code CODEMAP.md >/dev/null 2>&1; then
  git add CODEMAP.md
  echo "✓ CODEMAP.md regenerated and staged (was stale)."
fi

echo "✓ Pre-commit check passed."
exit 0
