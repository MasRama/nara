#!/bin/sh
# Nara pre-commit hook — runs the deterministic architecture doctor.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

echo "── Nara pre-commit check ──"

npm run architecture:doctor
if [ $? -ne 0 ]; then
  echo "❌ Architecture doctor failed. Fix the reported issues above."
  exit 1
fi

echo "✓ Pre-commit check passed."
exit 0
