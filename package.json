{
  "name": "nara",
  "version": "2.1.0",
  "private": true,
  "description": "AI-first TypeScript full-stack starter kit. ultimate-express + Svelte 5 + Inertia.js + SQLite. Raw SQL, plain functions, zero ORM. Auth, RBAC, CSRF, rate limiting, structured logging, file storage, and a complete user management UI.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "npx ts-node -r tsconfig-paths/register scripts/dev.ts",
    "build": "vite build && tsc && tsc-alias -p tsconfig.json && cp -rf dist build && cp -rf public build",
    "start": "node build/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "check:frontend": "svelte-check --tsconfig tsconfig.frontend.json",
    "migrate": "npx ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "migrate:rollback": "npx ts-node -r tsconfig-paths/register scripts/migrate.ts --rollback",
    "migrate:status": "npx ts-node -r tsconfig-paths/register scripts/migrate.ts --status",
    "migrate:fresh": "npx ts-node -r tsconfig-paths/register scripts/migrate.ts --fresh && npx ts-node -r tsconfig-paths/register scripts/seed.ts",
    "seed": "npx ts-node -r tsconfig-paths/register scripts/seed.ts",
    "lint:layers": "npx ts-node scripts/lint-layers.ts",
    "check:agents": "npx ts-node scripts/check-agents.ts",
    "check:security": "npx ts-node scripts/check-security.ts",
    "check:links": "npx ts-node scripts/check-links.ts",
    "check:filesize": "npx ts-node scripts/check-filesize.ts",
    "check:types": "npx ts-node scripts/check-types.ts",
    "check": "npm run lint && npm run check:frontend && npm run lint:layers && npm run check:agents && npm run check:security && npm run check:links && npm run check:filesize && npm run check:types && npm test",
    "gen:resource": "npx ts-node scripts/gen-resource.ts",
    "eval": "npx ts-node scripts/eval-agent.ts"
  },
  "author": "MasRama",
  "license": "MIT",
  "dependencies": {
    "@inertiajs/svelte": "^3.6.1",
    "@lucide/svelte": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^12.4.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "mode-watcher": "^1.1.0",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.2",
    "pino-roll": "^4.0.0",
    "sharp": "^0.35.3",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "ultimate-express": "2.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
