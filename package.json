{
  "name": "nara",
  "version": "3.0.0",
  "private": true,
  "bin": {
    "nara": "build/src/cli/index.js"
  },
  "description": "Architecture-aware TypeScript application kit. Build by feature, not by layer. Hono, Node.js, SQLite, and deterministic architecture tooling.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "npx ts-node -r tsconfig-paths/register scripts/dev.ts",
    "build": "node -r ts-node/register scripts/clean-build.ts && vite build && tsc && tsc-alias -p tsconfig.json && node -r ts-node/register scripts/copy-database-assets.ts",
    "start": "node build/server.js",
    "migrate": "node -r ts-node/register -r tsconfig-paths/register scripts/database.ts migrate",
    "migrate:status": "node -r ts-node/register -r tsconfig-paths/register scripts/database.ts migrate:status",
    "migrate:fresh": "node -r ts-node/register -r tsconfig-paths/register scripts/database.ts migrate:fresh",
    "seed": "node -r ts-node/register -r tsconfig-paths/register scripts/database.ts seed",
    "bootstrap:admin": "node -r ts-node/register -r tsconfig-paths/register scripts/bootstrap-admin.ts",
    "db:backup": "node -r ts-node/register -r tsconfig-paths/register scripts/database.ts db:backup",
    "db:check": "node -r ts-node/register -r tsconfig-paths/register scripts/database.ts db:check",
    "test": "vitest run",
    "test:production-serving": "vitest run --config vitest.integration.config.mjs tests/integration/production-serving.test.ts",
    "test:new-project": "vitest run --config vitest.integration.config.mjs tests/integration/new-project.test.ts",
    "test:linux-deployment": "vitest run --config vitest.integration.config.mjs tests/integration/linux-deployment.test.ts",
    "perf:sanity": "node scripts/perf-sanity.mjs",
    "validate:release": "npm run check && npm run test:production-serving && npm run test:linux-deployment && npm run test:new-project",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "check:frontend": "vue-tsc --noEmit -p tsconfig.frontend.json",
    "architecture:doctor": "npx ts-node -r tsconfig-paths/register src/cli/index.ts doctor",
    "check": "npm run lint && npm run check:frontend && npm test && npm run architecture:doctor"
  },
  "author": "MasRama",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.4.5",
    "hono": "^4.13.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.2",
    "pino-roll": "^4.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}
