# Server
NODE_ENV=development
PORT=5555
VITE_PORT=5173
APP_URL=http://localhost:5173

# Database
# DB_FILE is the path to SQLite file (relative to project root)
DB_FILE=database/dev.sqlite3

# Logging
# LOG_LEVEL options: trace, debug, info, warn, error, fatal
LOG_LEVEL=debug

# Security (V3-043 defaults shown; uncomment to override)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_LOCKOUT_ATTEMPTS=5
# AUTH_LOCKOUT_WINDOW_MS=900000
# MAX_JSON_BODY_BYTES=1048576

